# AirymaxOS 升级检查入口脚本
#
# 安装后从 site-packages 导入 airyupdate；源码树内直接运行时把同级
# services 目录加入搜索路径，不依赖安装也不隐藏导入错误。

"""AirymaxOS update check entry point (V-14)."""

import sys
from pathlib import Path

SERVICES = Path(__file__).resolve().parents[1] / "services"

if SERVICES.is_dir():
    sys.path.insert(0, str(SERVICES))

from airyupdate import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main())
