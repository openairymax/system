# AirymaxOS 开发运维工作站命令行入口脚本（P-18）
#
# 安装后从 site-packages 导入 devstation；源码树内直接运行时把同级 ops 与
# services 目录加入搜索路径，不依赖安装也不隐藏导入错误。参数与退出码
# 原样透传。

"""AirymaxOS development operations station entry point (P-18)."""

import sys
from pathlib import Path

BASE = Path(__file__).resolve().parents[1]
OPS = BASE / "ops"
SERVICES = BASE / "services"

if OPS.is_dir():
    sys.path.insert(0, str(OPS))
if SERVICES.is_dir():
    sys.path.insert(0, str(SERVICES))

from devstation.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
