# AirymaxOS 记忆运维命令行入口脚本
#
# 安装后从 site-packages 导入 memory；源码树内直接运行时把同级 ops 目录加入
# 搜索路径，不依赖安装也不隐藏导入错误。参数与退出码原样透传。

"""AirymaxOS memory operations entry point (P-17)."""

import sys
from pathlib import Path

BASE = Path(__file__).resolve().parents[1]
OPS = BASE / "ops"
SERVICES = BASE / "services"

if OPS.is_dir():
    sys.path.insert(0, str(OPS))
if SERVICES.is_dir():
    sys.path.insert(0, str(SERVICES))

from memory.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
