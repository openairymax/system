# AirymaxOS 电源与温度管理入口脚本
#
# 安装后从 site-packages 导入 airymax_power；源码树内直接运行时把同级
# services 目录加入搜索路径，不依赖安装也不隐藏导入错误。

"""AirymaxOS power entry point (X-06)."""

import sys
from pathlib import Path

SERVICES = Path(__file__).resolve().parents[1] / "services"

if SERVICES.is_dir():
    sys.path.insert(0, str(SERVICES))

from airymax_power import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
