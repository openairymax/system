[Unit]
Description=AirymaxOS Gateway Daemon (AgentsIPC)
Documentation=man:gateway_d(8)
After=network-online.target agentrt-firstboot.service
Requires=agentrt-firstboot.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service
# StartLimit* belongs to [Unit]; StartLimitIntervalSec in [Service] is
# silently ignored and the window falls back to the 10s default.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/gateway_d --config=/etc/agentrt/daemons/gateway_d.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2s
WatchdogSec=30s
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

User=airy
Group=airy
SupplementaryGroups=airy-net

MemoryMax=1G
MemoryHigh=800M
CPUQuota=200%
TasksMax=1024
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentrt/gateway
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

IOSchedulingClass=best-effort
IOSchedulingPriority=3

SyslogIdentifier=gateway_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
