[Unit]
Description=AirymaxOS Unified Configuration Subsystem (A-UCS)
Documentation=man:config_d(8)
After=agentrt-vfs.service agentrt-firstboot.service
Requires=agentrt-firstboot.service
Wants=agentrt-vfs.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service
# StartLimit* belongs to [Unit]; StartLimitIntervalSec in [Service] is
# silently ignored and the window falls back to the 10s default.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/config_d --load --config=/etc/agentrt/airy.conf
ExecReload=/usr/sbin/config_d --reload
ExecStop=/bin/true
# Type=oneshot 不设 TimeoutStartSec 时默认就是 infinity（plymouth 卡死的
# 同一类问题）：config_d 一旦在加载中阻塞，agentrt.target 的启动事务无界
# 等待，屏幕停在最后一行且无从归因。30 秒足够正常加载，超时按失败处理并
# 受 StartLimitBurst 约束重试。
TimeoutStartSec=30
TimeoutStopSec=15
Restart=on-failure
RestartSec=5s

User=airy
Group=airy
SupplementaryGroups=airy-config

MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
TasksMax=128
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/agentrt /var/lib/agentrt/config
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

IOSchedulingClass=best-effort
IOSchedulingPriority=4

SyslogIdentifier=config_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
