[Unit]
Description=AirymaxOS Unified Configuration Subsystem (A-UCS)
Documentation=man:config_d(8)
After=systemd-journald.service agentrt-firstboot.service
Requires=systemd-journald.service agentrt-firstboot.service
Wants=agentrt-vfs.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service
# StartLimit* belongs to [Unit]; StartLimitIntervalSec in [Service] is
# silently ignored and the window falls back to the 10s default.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/config_d --root /etc/agentrt
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1s
WatchdogSec=30s
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# 共享参数需下发到 kernel.airy.*，写 /proc/sys 要求 DAC 与 sysctl 权限；
# 以 root 运行但能力集收窄到最小必要两项，其余一律丢弃。
User=root
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_ADMIN
AmbientCapabilities=

MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
TasksMax=128
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes

IOSchedulingClass=best-effort
IOSchedulingPriority=4

SyslogIdentifier=config_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
