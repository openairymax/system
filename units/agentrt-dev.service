[Unit]
Description=AirymaxOS Device Management Daemon
Documentation=man:dev_d(8)
After=agentrt-gateway.service
Requires=agentrt-gateway.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/dev_d --config=/etc/agentrt/daemons/dev_d.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StartLimitBurst=3
StartLimitIntervalSec=300
WatchdogSec=30s
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

User=airy
Group=airy
SupplementaryGroups=airy-dev

MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
TasksMax=128
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentrt/devices /dev
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_MKNOD
AmbientCapabilities=CAP_SYS_ADMIN CAP_MKNOD

IOSchedulingClass=best-effort
IOSchedulingPriority=4

SyslogIdentifier=dev_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
