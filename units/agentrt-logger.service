[Unit]
Description=AirymaxOS Unified Logging Daemon
Documentation=man:logger_d(8)
After=agentrt-audit.service agentrt-firstboot.service
Requires=agentrt-audit.service agentrt-firstboot.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/logger_d --config=/etc/agentrt/daemons/logger_d.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1s
StartLimitBurst=5
StartLimitIntervalSec=300
WatchdogSec=30s
TimeoutStartSec=20
TimeoutStopSec=10
KillMode=control-group

User=airy
Group=airy
SupplementaryGroups=airy-alert airy-log

MemoryMax=1G
MemoryHigh=800M
CPUQuota=100%
TasksMax=256
LimitNOFILE=131072

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/agentrt /var/lib/agentrt/log
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

IOSchedulingClass=best-effort
IOSchedulingPriority=2

SyslogIdentifier=logger_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
