[Unit]
Description=Mount AirymaxOS Data Partition
Documentation=https://docs.agentrt.local/190-distribution/03-installer-design
After=local-fs.target
Before=agentrt.target multi-user.target
OnFailure=airy-incident@%n.service

[Service]
Type=oneshot
ExecStart=/usr/lib/airymaxos/scripts/stage_run.sh 数据分区 4 - /usr/bin/airy-disk mount
# 退出码 4 是「本机未启用数据分区」：0.0.3 及更早装成的系统没有 /data，
# 缺记录不是故障。不把 4 当作成功会让这类机器每次开机都留一个 failed
# 单元并触发 airy-incident@，真正需要修的挂载失败反而被噪声淹没。
SuccessExitStatus=4
RemainAfterExit=yes
# 慢盘上挂载真的会跑满两分钟，预期上限必须跟着单元超时走到 120 秒，
# 否则心跳一边走、上限一边提前宣告超时，现场无法判断该等还是该动。
Environment=AIRY_STAGE_LIMIT=120
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
