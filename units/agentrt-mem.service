[Unit]
Description=AirymaxOS Memory Subsystem Daemon
Documentation=man:mem_d(8)
After=agentrt-gateway.service agentrt-sched.service agentrt-firstboot.service
Requires=agentrt-gateway.service agentrt-firstboot.service
Wants=agentrt-sched.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service
# StartLimit* belongs to [Unit]; StartLimitIntervalSec in [Service] is
# silently ignored and the window falls back to the 10s default.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/mem_d --config=/etc/agentrt/daemons/mem_d.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2s
WatchdogSec=30s
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

User=airy
Group=airy
SupplementaryGroups=airy-memory

MemoryMax=2G
MemoryHigh=1600M
CPUQuota=100%
TasksMax=256
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentrt/memory /var/lib/agentrt/agents
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

IOSchedulingClass=best-effort
IOSchedulingPriority=3

SyslogIdentifier=mem_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
