[Unit]
Description=AirymaxOS Cognition Daemon (MicroCoreRT)
Documentation=man:cogn_d(8)
After=agentrt-gateway.service agentrt-firstboot.service
Requires=agentrt-gateway.service agentrt-firstboot.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/cogn_d --config=/etc/agentrt/daemons/cogn_d.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=300
WatchdogSec=30s
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

User=airy
Group=airy
SupplementaryGroups=airy-cogn

MemoryMax=4G
MemoryHigh=3.2G
CPUQuota=400%
TasksMax=256
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentrt/cogn
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

IOSchedulingClass=best-effort
IOSchedulingPriority=3

SyslogIdentifier=cogn_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
