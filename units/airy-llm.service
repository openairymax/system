[Unit]
Description=AirymaxOS Local Model Runtime
Documentation=https://docs.agentrt.local/140-application-development/06-agent-deployment
After=agentrt-firstboot.service
Requires=agentrt-firstboot.service
PartOf=agentrt.target
ConditionPathExists=/var/lib/airy-llm/manifest.json
OnFailure=airy-incident@%n.service
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=simple
ExecStart=/usr/bin/airy-model serve
Restart=on-failure
RestartSec=5s
# 75 = 准入拒绝，78 = 资产或引擎缺失。两者都是「此刻起不来」的确定结论，
# 重试只会在内存更紧的时候再撞一次，或在资产缺失时反复读同一份清单。
# 交给 OnFailure 记一次事件，等用户停实例、减 slot 或重装资产。
RestartPreventExitStatus=75 78
TimeoutStopSec=30
KillMode=mixed
Slice=airymax-agent.slice
User=airy
Group=airy
SupplementaryGroups=airy-cogn
TasksMax=512
LimitNOFILE=65536
StateDirectory=airy-llm
StateDirectoryMode=0750
ReadWritePaths=/var/lib/airy-llm
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RemoveIPC=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
IOSchedulingClass=best-effort
IOSchedulingPriority=4
SyslogIdentifier=airy-llm
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
