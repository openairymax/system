[Unit]
Description=AirymaxOS Alert Aggregator
Documentation=https://docs.agentrt.local/100-operations/04-alerting
After=agentrt-logger.service
Wants=agentrt-logger.service
OnFailure=airy-incident@%n.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/airy-alertd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
WatchdogSec=30s
TimeoutStartSec=15
TimeoutStopSec=10
User=airy
Group=airy
RuntimeDirectory=agentrt
RuntimeDirectoryMode=0755
StateDirectory=agentrt/alerts
StateDirectoryMode=0750
MemoryHigh=96M
MemoryMax=160M
CPUQuota=40%
TasksMax=64
LimitNOFILE=4096
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SyslogIdentifier=airy-alertd
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
