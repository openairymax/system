# ===========================================================================
# airy-boot-watch — 启动卡点自证
#
# 由 airy-boot-watch.timer 在开机 60 秒触发一次。整机是否继续推进由
# 默认目标与作业表的变化判定，因此本单元不能参与启动排序：要观察的恰恰
# 是「目标永远达不到」这一情形，挂在目标之后等于与被观察者同归于尽。
#
# 0.0.4 之前这里写着 After=sysinit.target，与上面这段注释自相矛盾，也让
# 看门狗在唯一需要它的场景里必然失效——285H（2026-11-09）冷启动被
# plymouth-read-write.service 无界阻塞在 sysinit.target 之前，该单元的
# journal 里是 -- No entries --：它一直在排队，从没拿到执行机会。
# DefaultDependencies=no 去掉 systemd 为服务隐式添加的 Requires/After=
# sysinit.target，否则显式删掉一行排序也仍然排在目标之后。
#
# 只保留 systemd-journald.socket 一条排序：本单元的全部结论都写 journal
# 与串口，journald 未就绪时结论只能落在丢失的 stdout 上。该 socket 由
# PID1 在非常早的阶段拉起，不依赖 sysinit.target。
#
# TimeoutStartSec 覆盖观测窗口（默认 40 秒）加取样开销。StandardOutput
# 只取 journal：console 与串口由脚本自己按设备实际归属写，交给 systemd
# 再复制一遍会在 /dev/console 归属串口的机器上打出两行。
# ===========================================================================
[Unit]
Description=Report a boot that stops making progress
Documentation=https://atomgit.com/openairymax/agent-linux
DefaultDependencies=no
After=systemd-journald.socket

[Service]
Type=oneshot
ExecStart=/usr/lib/airymaxos/scripts/boot_watch.sh
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
