[Unit]
Description=AirymaxOS Network Services Daemon
Documentation=man:net_d(8)
After=agentrt-gateway.service agentrt-sched.service agentrt-firstboot.service
Requires=agentrt-gateway.service agentrt-firstboot.service
Wants=agentrt-sched.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service
# StartLimit* belongs to [Unit]; StartLimitIntervalSec in [Service] is
# silently ignored and the window falls back to the 10s default.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/net_d --config=/etc/agentrt/daemons/net_d.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2s
WatchdogSec=30s
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

User=airy
Group=airy
SupplementaryGroups=airy-net

MemoryMax=1G
MemoryHigh=800M
CPUQuota=200%
TasksMax=1024
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentrt/net
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

IOSchedulingClass=best-effort
IOSchedulingPriority=2

SyslogIdentifier=net_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
