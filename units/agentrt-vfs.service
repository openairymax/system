[Unit]
Description=AirymaxOS Virtual File System Daemon
Documentation=man:vfs_d(8)
After=agentrt-net.service agentrt-sec.service
Wants=agentrt-net.service agentrt-sec.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/vfs_d --config=/etc/agentrt/daemons/vfs_d.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2s
StartLimitBurst=3
StartLimitIntervalSec=300
WatchdogSec=30s
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

User=airy
Group=airy
SupplementaryGroups=airy-vfs

MemoryMax=1G
MemoryHigh=800M
CPUQuota=100%
TasksMax=512
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentrt/vfs /var/lib/agentrt/agents
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE

IOSchedulingClass=best-effort
IOSchedulingPriority=2

SyslogIdentifier=vfs_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
