[Unit]
Description=AirymaxOS Scheduling Daemon (sched_tac)
Documentation=man:sched_d(8)
After=agentrt-gateway.service agentrt-firstboot.service
Requires=agentrt-gateway.service agentrt-firstboot.service
PartOf=agentrt.target
OnFailure=airy-incident@%n.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/sched_d --config=/etc/agentrt/daemons/sched_d.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1s
StartLimitBurst=2
StartLimitIntervalSec=300
WatchdogSec=30s
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

User=airy
Group=airy
SupplementaryGroups=airy-sched

MemoryMax=256M
MemoryHigh=200M
CPUQuota=100%
TasksMax=128
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentrt/sched
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_RESOURCE
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_RESOURCE

IOSchedulingClass=realtime
IOSchedulingPriority=3

SyslogIdentifier=sched_d
LogLevelMax=info
StandardOutput=journal
StandardError=journal
OOMPolicy=stop

[Install]
WantedBy=agentrt.target
